{
  "name": "mcp-storyset",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for storyset.com — search, download, and recolor free illustrations. TypeScript port running as a Cloudflare Workers remote MCP server.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "1.29.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
