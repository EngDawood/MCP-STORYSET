{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-storyset",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "StorysetMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StorysetMCP"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
