{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storyset-mcp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "storyset-mcp.engdawood.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://storyset-mcp.engdawood.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "StorysetMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StorysetMCP"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
